{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\" codex",
            "commandWindows": "\"${CLAUDE_PLUGIN_ROOT}\\scripts\\run-bash.cmd\" session-start.sh codex",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
